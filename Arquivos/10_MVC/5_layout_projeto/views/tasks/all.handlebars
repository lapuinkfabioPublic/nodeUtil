<div class="container">
    <h1>Tasks</h1>
    {{#if tasks}}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {{#each tasks}}
                    <tr>
                        <td>{{this.title}}</td>
                        <td>{{this.description}}</td>
                        <td>{{#if this.done}}Completed{{else}}Pending{{/if}}</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p>No tasks found.</p>
    {{/if}}
</div>
