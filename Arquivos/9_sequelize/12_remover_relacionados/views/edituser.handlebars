<h1>Editar usuário</h1>
<form action="/users/update/{{user.id}}" class="form" method="POST">
    <div class="form-control">
        <label for="name">Nome:</label>
        <input type="text" name="name" value="{{user.name}}" placeholder="Digite o nome do usuário" required>
    </div>
    <div class="form-control">
        <label for="occupation">Profissão:</label>
        <input type="text" name="occupation" value="{{user.occupation}}" placeholder="Digite a profissão do usuário" required>
    </div>
    <div class="form-control form-checkbox">
        <input type="checkbox" name="newsletter" id="newsletter" {{#if user.newsletter}}checked{{/if}}>
        <label for="newsletter">Deseja receber nossa newsletter?</label>
    </div>

    <button type="submit">Atualizar usuário</button>
</form>

<div class="address-container">
    <h2>Endereços do usuário</h2>
    
    {{#if user.Addresses}}
        {{#each user.Addresses}}
        <div class="address-item">
            <form action="/addresses/update/{{this.id}}" class="form" method="POST">
                <div class="form-control">
                    <label for="street">Rua:</label>
                    <input type="text" name="street" value="{{this.street}}" placeholder="Digite a rua" required>
                </div>
                <div class="form-control">
                    <label for="number">Número:</label>
                    <input type="text" name="number" value="{{this.number}}" placeholder="Digite o número" required>
                </div>
                <div class="form-control">
                    <label for="city">Cidade:</label>
                    <input type="text" name="city" value="{{this.city}}" placeholder="Digite a cidade" required>
                </div>
                <button type="submit">Atualizar endereço</button>
            </form>
            <form action="/addresses/delete/{{this.id}}" method="POST" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja deletar este endereço?');">
               <input type="hidden" name="userId" value="{{user.id}}">
               <button type="submit" class="btn btn-delete btn-small">Remover</button>
            </form>

        </div>
        {{/each}}
    {{else}}
        <p>Nenhum endereço registrado</p>
    {{/if}}

    <h3>Adicionar novo endereço</h3>
    <form action="/addresses/create" class="form" method="POST">
        <input type="hidden" name="userId" value="{{user.id}}">

        <div class="form-control">
            <label for="street">Rua:</label>
            <input type="text" name="street" placeholder="Digite a rua" required>
        </div>
        <div class="form-control">
            <label for="number">Número:</label>
            <input type="text" name="number" placeholder="Digite o número" required>
        </div>
        <div class="form-control">
            <label for="city">Cidade:</label>
            <input type="text" name="city" placeholder="Digite a cidade" required>
        </div>
        <button type="submit">Adicionar endereço</button>
    </form>
</div>

<a href="/">Voltar para a página inicial</a>
